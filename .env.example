# Frontend (exposto ao navegador — use as chaves PÚBLICAS do Supabase, nunca a service_role)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Backend / serverless (api/*.ts — NUNCA prefixar com VITE_, senão vaza pro navegador)
ANTHROPIC_API_KEY=
# Necessário só para o script de seed (supabase/seed/run-seed.ts), que grava direto no banco
SUPABASE_SERVICE_ROLE_KEY=
